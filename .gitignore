# --- 构建产物（Wails v3：产物在项目根 bin/） ---
bin/

# build/ 下的构建资产需入库，供 CI 拉取后打包：
# v3 体系 = build/config.yml + Taskfile 体系 + 平台资产（Info.plist 等由
# `wails3 task common:update:build-assets` 从 config.yml 生成）。
# 注意：Wails 打包器读取的是 appicon.png（不是 appicon.svg），且不会从 svg
# 自动生成 png。因此 appicon.png 必须入库。改 appicon.svg 后需手动重新导出：
#   magick build/appicon.svg build/appicon.png
# icns/ico/Assets.car 是 `wails3 generate icons` 生成的产物，保持忽略。
# 注意：须用 build/* 而非 build/，目录被整体排除时 ! 例外不生效
build/*
!build/config.yml
!build/Taskfile.yml
!build/README.md
!build/appicon.svg
!build/appicon.png
!build/darwin/
!build/darwin/Taskfile.yml
!build/darwin/Info.plist
!build/darwin/Info.dev.plist
!build/windows/
!build/windows/Taskfile.yml
!build/linux/
!build/linux/Taskfile.yml
build/darwin/icons.icns
build/darwin/Assets.car
build/windows/icon.ico
build/ios/
**/dist/
*.app
*.app.dSYM/
ServerPanel
*.syso
*.dmg
*.pkg

# --- 依赖 ---
**/node_modules/

# --- 前端本地/生成 ---
frontend/dist/
frontend/node_modules/
# --- 日志 / 编辑器 / OS ---
*.log
*.DS_Store
.DS_Store
.idea/
.vscode/
*.swp
*~
.playwright-mcp/
.history/

# --- 环境与密钥（勿入库）---
.env
.env.*
!.env.example
*.pem
*.key
id_rsa
id_ed25519
*.p12
*.mobileprovision

# --- 测试 / 覆盖率 / 临时 ---
coverage/
*.out
*.test
/tmp/
tmp/
*.bak
*.tmp
*.orig
*.rej

# --- 本地 AI / 会话 / 计划缓存 ---
.zcode/
.grok/
.cursor/
.claude/settings.local.json
.agents/
.codex/
.mimosa/

# --- 本地冒烟/截图产物（可选手动提交 docs 正文）---
docs/*-smoke-report.html
docs/ipannel-vue-smoke-report.html
docs/**/screenshots/
docs/**/*.png
!docs/**/README.md

# --- 系统 / 压缩包杂项 ---
__MACOSX/
Thumbs.db
Desktop.ini
*.zip
*.tar.gz
!docs/**/*.md

# task 缓存
.task/

# 内置 agent 二进制（task agent:build 产物）
internal/agentres/bin/spanel-agent-*
